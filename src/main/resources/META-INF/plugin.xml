<idea-plugin>
    <id>com.taikang.yantu.assistant.jetbrains</id>
    <name>Yantu Assistant</name>
    <vendor>内部研发平台</vendor>
    <description><![CDATA[Yantu Assistant connects the JetBrains IDE to the internal research platform for chat, Skill management, Wiki downloads, and local agent telemetry.]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="研途助手"
                    anchor="left"
                    icon="/icons/yantu.svg"
                    factoryClass="com.taikang.yantu.ui.YantuToolWindowFactory"/>
        <postStartupActivity implementation="com.taikang.yantu.startup.YantuStartupActivity"/>
    </extensions>
</idea-plugin>
